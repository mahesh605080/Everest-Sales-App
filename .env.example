# PostgreSQL connection
DATABASE_URL=postgresql://sfa:change-this-password@localhost:5432/sfa

# Long random text used to sign login sessions. Generate one with:  openssl rand -hex 32
AUTH_SECRET=replace-with-a-long-random-string

# Password given to the first admin and to sample/imported users. They must change it after first login.
DEFAULT_USER_PASSWORD=Everest@123

# Set to "false" only if the site is opened over plain http (not recommended)
COOKIE_SECURE=true

# Map. Leave empty to use OpenStreetMap tiles.
# To use a Nepali provider (Baato, Galli Maps) paste the MapLibre style URL they give you, including your key.
NEXT_PUBLIC_MAP_STYLE_URL=

# ---- only used by docker-compose.yml ----
DB_PASSWORD=change-this-password
DOMAIN=sfa.example.com

# Optional: lets a scheduler run the alert rules. Call  GET /api/cron/alerts?key=<this value>  every 5 minutes.
CRON_SECRET=

# ---- platform service (backend/, Python) ----
# It reads DATABASE_URL and AUTH_SECRET above. AUTH_SECRET must be at least 32 characters in production.
# Other sites allowed to call the platform API from a browser, comma-separated. Leave empty when everything is on one domain.
CORS_ORIGINS=
# Lifetime of the short login token (minutes) and of the refresh token (days).
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
# For local development without the reverse proxy: where the web app finds the platform service.
PLATFORM_URL=http://localhost:8000
# Address of the web app as people open it (used in emailed links), and the company mail server for password-reset emails.
# Without SMTP, a reset code is issued by an administrator instead.
PUBLIC_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Uploaded files: where they are kept (a volume in Docker), the largest file and the default allowance per person, in bytes.
FILES_DIR=./data/files
FILE_MAX_BYTES=10485760
FILE_QUOTA_BYTES=209715200
# Browser push. Make the pair once with:  cd backend && python -m app.cli vapid   The private key must stay on the server.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# iPhone push, straight to Apple. Needs an Apple Developer account; leave empty until then. APNS_KEY is the .p8 file's contents with line breaks written as \n.
APNS_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=com.everestparenterals.sales
APNS_SANDBOX=false
# Queue: tries before giving up, and how many notifications one person may get in an hour.
NOTIFY_MAX_ATTEMPTS=6
NOTIFY_MAX_PER_USER_PER_HOUR=30
